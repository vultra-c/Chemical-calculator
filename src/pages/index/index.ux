  color: #f2f6f8;
  font-size: 33px;
  font-weight: bold;
}
.subtitle {
  color: #8a97a5;
  font-size: 19px;
  margin-top: 8px;
}
.menu {
  flex-direction: column;
  width: 100%;
}
.card {
  background-color: #151b23;
  border-radius: 22px;
  margin-bottom: 22px;
  width: 100%;
}
.menu-card {
  flex-direction: column;
  padding: 10px 12px;
}
.primary {
  border: 1px solid rgba(52, 211, 153, 0.45);
}
.menu-btn {
  background-color: rgba(52, 211, 153, 0.12);
  color: #34d399;
  font-size: 28px;
  font-weight: bold;
  border-radius: 14px;
  padding: 18px 20px;
  width: 100%;
}
.menu-desc {
  color: #8a97a5;
  font-size: 19px;
  margin-top: 10px;
  margin-bottom: 4px;
  margin-left: 6px;
}
