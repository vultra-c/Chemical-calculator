<template>
  <div class="page" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="header">
      <image class="logo" src="/icon.png"></image>
      <div class="header-text">
        <text class="title">化学反应计算器</text>
        <text class="subtitle">纯离线 · 配平 · 质量计算</text>
      </div>
    </div>

    <div class="menu">
      <div class="card menu-card primary">
        <input class="menu-btn" type="button" value="反应计算  ›" onclick="goCalc"></input>
        <text class="menu-desc">输入反应物，自动推导配平</text>
      </div>

      <div class="card menu-card">
        <input class="menu-btn" type="button" value="元素数据  ›" onclick="goElements"></input>
        <text class="menu-desc">相对原子质量离线查询</text>
      </div>
    </div>

    <div class="spacer"></div>
    <text class="foot" if="{{navError}}">{{navError}}</text>
    <text class="foot">支持化学式 / 中文名称 · 右滑退出 · {{buildTag}}</text>
  </div>
</template>

<script>
import router from '@system.router'
import app from '@system.app'

export default {
  private: {
    buildTag: 'v1.1.0',
    navError: '',
    touchStartX: 0,
    touchStartY: 0,
    touchStartTime: 0
  },

  goCalc() {
    this.nav('pages/calc')
  },
  goElements() {
    this.nav('pages/elements')
  },
  nav(path) {
    try {
      router.push({ uri: '/' + path })
    } catch (e) {
      this.navError = '跳转失败: ' + e.message
    }
  },
  onTouchStart(evt) {
    const t = evt.changedTouches && evt.changedTouches[0]
    if (!t) return
    this.touchStartX = t.clientX != null ? t.clientX : t.pageX
    this.touchStartY = t.clientY != null ? t.clientY : t.pageY
    this.touchStartTime = Date.now()
  },
  onTouchEnd(evt) {
    const t = evt.changedTouches && evt.changedTouches[0]
    if (!t || !this.touchStartTime) return
    const endX = t.clientX != null ? t.clientX : t.pageX
    const endY = t.clientY != null ? t.clientY : t.pageY
    const dx = endX - this.touchStartX
    const dy = endY - this.touchStartY
    const dt = Date.now() - this.touchStartTime
    this.touchStartTime = 0
    if (dx > 90 && Math.abs(dy) < 70 && dt < 800) {
      try {
        app.terminate()
      } catch (e) {
        this.navError = '退出失败: ' + e.message
      }
    }
  }
}
</script>

