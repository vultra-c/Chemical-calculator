  color: #f2f6f8;
  font-size: 33px;
  font-weight: bold;
}
.subtitle {
  color: #8a97a5;
  font-size: 19px;
  margin-top: 8px;
}
.menu {
  flex-direction: column;
  width: 100%;
}
.card {
  background-color: #151b23;
  border-radius: 22px;
}
.menu-card {
  flex-direction: row;
  align-items: center;
  padding: 24px 26px;
  margin-bottom: 22px;
  width: 100%;
}
.primary {
  border: 1px solid rgba(52, 211, 153, 0.45);
}
.dot {
  width: 22px;
  height: 22px;
  border-radius: 11px;
  margin-right: 22px;
  flex-shrink: 0;
}
.dot-teal {
  background-color: #34d399;
}
.dot-amber {
  background-color: #fbbf24;
}
.menu-text {
  flex-direction: column;
  flex-grow: 1;
}
.menu-title {
  color: #f2f6f8;
  font-size: 28px;
  font-weight: bold;
}
.menu-desc {
  color: #8a97a5;
  font-size: 19px;
  margin-top: 6px;
}
.arrow {
  color: #4a5561;
  font-size: 34px;
  flex-shrink: 0;
}
.spacer {
  flex-grow: 1;
}
