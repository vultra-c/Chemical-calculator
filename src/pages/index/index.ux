<!--
  化学工具箱 · 主页（336×480）
  闪念小抄 UI 风格：hd.png 顶栏 + 112px 大圆角功能卡片列表。
  卡片左侧带分类色条（蓝=计算类 / 青=查询类 / 橙=工具类），扫一眼即可分区；
  右滑 / 返回键退出应用；onShow 按持久化设置恢复常亮。
-->
<template>
  <div class="page" @swipe="onSwipe">

    <!-- 功能卡片列表（9 项，可滚动） -->
    <list class="list" id="menuList">
      <list-item for="{{menu}}" tid="id" class="item" type="menu" @click="go($item)">
        <div class="item-bar {{$item.tone}}"></div>
        <div class="item-content">
          <text class="itemtext">{{$item.title}}</text>
          <text class="itemtext2">{{$item.sub}}</text>
        </div>
        <img static src="/common/images/enter.png" class="arrow" />
      </list-item>
    </list>


    <!-- 顶栏（闪念小抄同款：底图 + 返回 + 双行居中标题；右上角 more 进设置） -->
    <img static src="/common/images/hd.png" class="hd-bg" />
    <img static src="/common/images/back.png" class="hd-back" @click="exitApp" />
    <img static src="/common/images/more.png" class="hd-more" @click="goSettings" />
    <text static class="hd-sub">离线化学计算</text>
    <text static class="hd-title">化学工具箱</text>

  </div>
</template>

<script>
import router from '@system.router'
import app from '@system.app'
import { loadSettings, applyKeepScreenOn } from '../../common/logic/settings.js'

export default {
  private: {
    menu: [
      { id: 'm1', uri: 'pages/reaction',  title: '反应计算',     sub: '输入反应物，自动推导并配平', tone: 'tone-calc' },
      { id: 'm2', uri: 'pages/balance',   title: '方程式配平',   sub: '输入未配平方程式，自动配系数', tone: 'tone-calc' },
      { id: 'm3', uri: 'pages/molar',     title: '相对分子质量', sub: 'M、元素质量分数与质量比', tone: 'tone-calc' },
      { id: 'm4', uri: 'pages/gas',       title: '气体标况换算', sub: '体积 ↔ 质量 ↔ 分子个数', tone: 'tone-calc' },
      { id: 'm5', uri: 'pages/element',   title: '元素查询',     sub: '按元素或名称查找方程式', tone: 'tone-info' },
      { id: 'm6', uri: 'pages/synth',     title: '合成查询',     sub: '输入产物，逆推需要的反应物', tone: 'tone-info' },
      { id: 'm7', uri: 'pages/mass',      title: '质量计算',     sub: '已知一种质量，推算全部物质', tone: 'tone-calc' },
      { id: 'm8', uri: 'pages/catalog',   title: '常用物质表',   sub: '浏览常见物质，点选填入', tone: 'tone-info' },
      { id: 'm9', uri: 'pages/reference', title: '化学速查',     sub: '周期表 · 离子 · 沉淀 · 颜色 · 气体', tone: 'tone-tool' }
    ]
  },

  onShow() {
    loadSettings((s) => {
      if (s.keepScreenOn) applyKeepScreenOn(true)
    })
  },

  go(item) {
    if (item && item.uri) {
      router.push({ uri: item.uri })
    }
  },
  goSettings() {
    router.push({ uri: 'pages/settings' })
  },
  exitApp() {
    app.terminate()
  },
  onSwipe(e) {
    if (e && e.direction === 'right') {
      app.terminate()
    }
  },
  onBackPress() {
    app.terminate()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

/* 分类色条颜色定义在公共 style.css（tone-calc / tone-info / tone-tool） */
</style>
