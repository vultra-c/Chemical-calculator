  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 16px;
  width: 100%;
}
.chip {
  background-color: #0e1319;
  color: #aeb9c4;
  font-size: 21px;
  border-radius: 14px;
  padding: 10px 18px;
  margin-right: 12px;
  margin-bottom: 10px;
}
.chip.sel {
  background-color: rgba(52, 211, 153, 0.18);
  color: #34d399;
  border: 1px solid rgba(52, 211, 153, 0.55);
}
.btn-main {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-image: linear-gradient(90deg, #10b981, #34d399);
  border-radius: 18px;
  padding: 20px;
  margin-top: 4px;
  width: 100%;
}
