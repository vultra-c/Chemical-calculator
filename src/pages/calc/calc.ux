<template>
  <div class="page" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <scroll class="scroll" scroll-y="true">
      <div class="inner">
        <div class="header">
          <input class="btn-back" type="button" value="‹ 返回" onclick="goBack"></input>
          <text class="h-title">反应计算</text>
          <input class="btn-reset" type="button" value="清空" onclick="clearAll"></input>
        </div>

        <div class="mode-row">
          <input class="mode-btn {{kbMode ? 'on' : ''}}" type="button" value="公式" onclick="setModeKb"></input>
          <input class="mode-btn {{kbMode ? '' : 'on'}}" type="button" value="中文名" onclick="setModeZh"></input>
        </div>

        <div class="card block">
          <text class="label">{{kbMode ? '化学式输入（内置键盘 · 无联想）' : '中文名称输入（系统联想）'}}</text>
          <div class="ipt-view" if="{{kbMode}}" onclick="focusKb">
            <text class="ipt-text {{inputText ? '' : 'ph'}}">{{inputText || '如：kmno4 或 Fe+CuSO4'}}</text>
            <text class="caret">|</text>
          </div>
          <input class="ipt" if="{{!kbMode}}" type="text" placeholder="如：铁+硫酸铜" value="{{inputText}}" onchange="onInput"></input>

          <div class="chips">
            <input class="chip" type="button" value="铁+硫酸铜" onclick="fillExample1"></input>
            <input class="chip" type="button" value="碳酸钙+盐酸" onclick="fillExample2"></input>
            <input class="chip" type="button" value="过氧化氢" onclick="fillExample3"></input>
          </div>
          <input class="btn-main" type="button" value="推导并配平" onclick="doAnalyze"></input>
        </div>

        <div class="kb-wrap" if="{{kbMode}}">
          <div class="kb-row">
            <input class="key num" type="button" value="4" onclick="keyPress('4')"></input>
            <input class="key num" type="button" value="3" onclick="keyPress('3')"></input>
            <input class="key num" type="button" value="2" onclick="keyPress('2')"></input>
            <input class="key num" type="button" value="1" onclick="keyPress('1')"></input>
            <input class="key wide" type="button" value="+" onclick="keyPress('+')"></input>
            <input class="key wide" type="button" value="·" onclick="keyPress('·')"></input>
            <input class="key wide" type="button" value="(" onclick="keyPress('(')"></input>
            <input class="key wide" type="button" value=")" onclick="keyPress(')')"></input>
          </div>
          <div class="kb-row">
            <input class="key" type="button" value="Q" onclick="keyPress('Q')"></input>
            <input class="key" type="button" value="W" onclick="keyPress('W')"></input>
            <input class="key" type="button" value="E" onclick="keyPress('E')"></input>
            <input class="key" type="button" value="R" onclick="keyPress('R')"></input>
            <input class="key" type="button" value="T" onclick="keyPress('T')"></input>
            <input class="key" type="button" value="Y" onclick="keyPress('Y')"></input>
            <input class="key" type="button" value="U" onclick="keyPress('U')"></input>
            <input class="key" type="button" value="I" onclick="keyPress('I')"></input>
          </div>
          <div class="kb-row indent1">
            <input class="key" type="button" value="O" onclick="keyPress('O')"></input>
            <input class="key" type="button" value="P" onclick="keyPress('P')"></input>
            <input class="key" type="button" value="A" onclick="keyPress('A')"></input>
            <input class="key" type="button" value="S" onclick="keyPress('S')"></input>
            <input class="key" type="button" value="D" onclick="keyPress('D')"></input>
            <input class="key" type="button" value="F" onclick="keyPress('F')"></input>
            <input class="key" type="button" value="G" onclick="keyPress('G')"></input>
            <input class="key" type="button" value="H" onclick="keyPress('H')"></input>
          </div>
          <div class="kb-row indent2">
            <input class="key" type="button" value="J" onclick="keyPress('J')"></input>
            <input class="key" type="button" value="K" onclick="keyPress('K')"></input>
            <input class="key" type="button" value="L" onclick="keyPress('L')"></input>
            <input class="key" type="button" value="B" onclick="keyPress('B')"></input>
            <input class="key" type="button" value="N" onclick="keyPress('N')"></input>
            <input class="key" type="button" value="M" onclick="keyPress('M')"></input>
            <input class="key caps" type="button" value="{{capsOn ? '⇪' : '⇧'}}" onclick="toggleCaps"></input>
            <input class="key del" type="button" value="⌫" onclick="keyBack"></input>
          </div>
        </div>

        <text class="error" if="{{errorMsg}}">{{errorMsg}}</text>

        <div class="card block" if="{{result}}">
          <div class="row-badges">
            <text class="badge tag">{{result.tag}}</text>
            <text class="badge cond" if="{{result.cond}}">{{result.cond}}</text>
          </div>
          <text class="eq">{{eqLeftStr}}</text>
          <div class="arrow-row">
            <text class="arrow-line"></text>
            <text class="arrow-txt">{{result.cond ? '==>' : '==>'}}</text>
            <text class="arrow-line"></text>
          </div>
          <text class="eq right">{{eqRightStr}}</text>
          <text class="note" if="{{result.note}}">{{result.note}}</text>
        </div>

        <div class="card block" if="{{result}}">
          <text class="label">质量计量：选择已知质量的物质</text>
          <div class="chips">
            <input
              class="chip {{idx===selIdx ? 'sel' : ''}}"
              type="button"
              value="{{s.display}}"
              for="(idx, s) in result.substances"
              onclick="pickSub(idx)"></input>
          </div>
          <input class="ipt" type="number" placeholder="输入质量（克）" value="{{massText}}" onchange="onMass"></input>
          <input class="btn-sub" type="button" value="计算其余物质质量" onclick="doCalcMass"></input>
          <text class="mass-msg" if="{{massMsg}}">{{massMsg}}</text>
          <div class="m-row head" if="{{massRows.length}}">
            <text class="m-c">物质</text>
            <text class="m-c">系数×M</text>
            <text class="m-c">摩尔/mol</text>
            <text class="m-c">质量/g</text>
          </div>
          <div class="m-row {{r.isRef ? 'ref' : ''}}" for="(ri, r) in massRows">
            <text class="m-c strong">{{r.coef > 1 ? r.coef : ''}}{{r.display}}{{r.isRef ? ' ●' : ''}}</text>
            <text class="m-c dim">{{r.coef}}×{{r.molMass}}</text>
            <text class="m-c">{{r.moles}}</text>
            <text class="m-c accent">{{r.grams}}</text>
          </div>
        </div>

        <text class="foot-tip">「清空」重开 · 右滑返回 · {{buildTag}}</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import { splitReactants } from '../../common/chemistry/parser.js'
import { analyzeList, calcStoich } from '../../common/chemistry/reactions.js'

export default {
  private: {
    buildTag: 'v1.2.0',
    kbMode: true,
    capsOn: false,
    inputText: '',
    result: null,
    eqLeftStr: '',
    eqRightStr: '',
    errorMsg: '',
    selIdx: 0,
    massText: '',
    massRows: [],
    massMsg: '',
    touchStartX: 0,
    touchStartY: 0,
    touchStartTime: 0
  },

  goBack() {
    router.back()
  },
  onTouchStart(evt) {
    const t = evt.changedTouches && evt.changedTouches[0]
    if (!t) return
    this.touchStartX = t.clientX != null ? t.clientX : t.pageX
    this.touchStartY = t.clientY != null ? t.clientY : t.pageY
    this.touchStartTime = Date.now()
  },
  onTouchEnd(evt) {
    const t = evt.changedTouches && evt.changedTouches[0]
    if (!t || !this.touchStartTime) return
    const endX = t.clientX != null ? t.clientX : t.pageX
    const endY = t.clientY != null ? t.clientY : t.pageY
    const dx = endX - this.touchStartX
    const dy = endY - this.touchStartY
    const dt = Date.now() - this.touchStartTime
    this.touchStartTime = 0
    if (dx > 90 && Math.abs(dy) < 70 && dt < 800) {
      router.back()
    }
  },
  setModeKb() {
    this.kbMode = true
  },
  setModeZh() {
    this.kbMode = false
  },
  focusKb() {},
  onInput(evt) {
    this.inputText = evt.value
  },
  onMass(evt) {
    this.massText = evt.value
  },
  keyPress(ch) {
    this.inputText = this.inputText + (this.capsOn ? ch : ch.toLowerCase())
    if (this.capsOn) this.capsOn = false
  },
  keyBack() {
    this.inputText = this.inputText.slice(0, -1)
  },
  toggleCaps() {
    this.capsOn = !this.capsOn
  },
  fillExample1() {
    this.inputText = '铁+硫酸铜'
    this.doAnalyze()
  },
  fillExample2() {
    this.inputText = '碳酸钙+盐酸'
    this.doAnalyze()
  },
  fillExample3() {
    this.inputText = '过氧化氢'
    this.doAnalyze()
  },
  resetResultView() {
    this.result = null
    this.eqLeftStr = ''
    this.eqRightStr = ''
    this.errorMsg = ''
    this.selIdx = 0
    this.massRows = []
    this.massMsg = ''
  },
  doAnalyze() {
    const tokens = splitReactants(this.inputText)
    if (!tokens.length) {
      this.resetResultView()
      this.errorMsg = '请先输入至少一种反应物'
      return
    }
    const r = analyzeList(tokens)
    if (!r.ok) {
      this.resetResultView()
      this.errorMsg = r.message || '无法推导该反应'
      return
    }
    this.errorMsg = ''
    let left = ''
    let right = ''
    r.substances.forEach((s, i) => {
      const label = (s.coef > 1 ? s.coef : '') + s.display
      const sep = i === 0 ? '' : ' + '
      if (s.side === 'L') left += sep + label
      else right += (right === '' ? '' : ' + ') + label
    })
    this.result = r
    this.eqLeftStr = left
    this.eqRightStr = right
    this.selIdx = 0
    this.massRows = []
    this.massMsg = ''
  },
  pickSub(idx) {
    this.selIdx = idx
    this.massRows = []
    this.massMsg = ''
  },
  doCalcMass() {
    if (!this.result) return
    const out = calcStoich(this.result, this.selIdx, parseFloat(this.massText))
    if (!out.ok) {
      this.massRows = []
      this.massMsg = out.message || '请输入有效的质量'
      return
    }
    this.massMsg = ''
    this.massRows = out.rows.map((row) => {
      const src = this.result.substances[row.index]
      return {
        display: row.display,
        coef: row.coef,
        molMass: src.mass,
        moles: row.moles,
        grams: row.grams,
        isRef: row.isRef
      }
    })
  },
  clearAll() {
    this.inputText = ''
    this.massText = ''
    this.resetResultView()
  }
}
</script>

