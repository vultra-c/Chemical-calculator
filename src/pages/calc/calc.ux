  justify-content: center;
  background-color: rgba(52, 211, 153, 0.14);
  border-radius: 18px;
  padding: 18px;
  margin-top: 4px;
  width: 100%;
}
.btn-sub-t {
  color: #34d399;
  font-size: 25px;
  font-weight: bold;
}
.error {
  background-color: rgba(248, 113, 113, 0.12);
  border: 1px solid rgba(248, 113, 113, 0.45);
  color: #f87171;
  font-size: 23px;
  border-radius: 18px;
  padding: 20px 24px;
  margin-bottom: 24px;
}
.row-badges {
  flex-direction: row;
  align-items: center;
  margin-bottom: 18px;
  width: 100%;
}
.badge {
  font-size: 19px;
  border-radius: 12px;
  padding: 6px 16px;
  margin-right: 12px;
}
.tag {
  background-color: rgba(52, 211, 153, 0.15);
  color: #34d399;
}
.cond {
  background-color: rgba(251, 191, 36, 0.15);
  color: #fbbf24;
}
.eq {
  color: #f2f6f8;
  font-size: 30px;
  font-weight: bold;
  line-height: 44px;
}
.right {
  text-align: right;
}
.arrow-row {
