<template>
  <div class="page" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <scroll class="scroll" scroll-y="true">
      <div class="inner">
        <div class="header">
          <text class="back" onclick="goBack">‹</text>
          <text class="h-title">反应计算</text>
          <text class="reset-btn" onclick="clearAll">清空</text>
        </div>

        <div class="card block">
          <text class="label">反应物（多种用 + 分隔，支持中文名）</text>
          <input class="ipt" type="text" placeholder="如：铁+硫酸铜" value="{{inputText}}" onchange="onInput"></input>
          <div class="chips">
            <text class="chip" onclick="fillExample1()">铁＋硫酸铜</text>
            <text class="chip" onclick="fillExample2()">碳酸钙＋盐酸</text>
            <text class="chip" onclick="fillExample3()">过氧化氢</text>
          </div>
          <div class="btn-main" onclick="doAnalyze">
            <text class="btn-main-t">推导并配平</text>
          </div>
        </div>

        <text class="error" if="{{errorMsg}}">{{errorMsg}}</text>

        <div class="card block" if="{{result}}">
          <div class="row-badges">
            <text class="badge tag">{{result.tag}}</text>
            <text class="badge cond" if="{{result.cond}}">{{result.cond}}</text>
          </div>
          <text class="eq">{{eqLeftStr}}</text>
          <div class="arrow-row">
            <text class="arrow-line"></text>
            <text class="arrow-txt">→</text>
            <text class="arrow-line"></text>
          </div>
          <text class="eq right">{{eqRightStr}}</text>
          <text class="note" if="{{result.note}}">{{result.note}}</text>
        </div>

        <div class="card block" if="{{result}}">
          <text class="label">质量计量：选择已知质量的物质</text>
          <div class="chips">
            <text
              class="chip {{idx===selIdx ? 'sel' : ''}}"
              for="(idx, s) in result.substances"
              onclick="pickSub(idx)">{{s.display}}</text>
          </div>
          <input class="ipt" type="number" placeholder="输入质量（克）" value="{{massText}}" onchange="onMass"></input>
          <div class="btn-sub" onclick="doCalcMass">
            <text class="btn-sub-t">计算其余物质质量</text>
          </div>
          <text class="mass-msg" if="{{massMsg}}">{{massMsg}}</text>
          <div class="m-row head" if="{{massRows.length}}">
            <text class="m-c">物质</text>
            <text class="m-c">系数×M</text>
            <text class="m-c">摩尔/mol</text>
            <text class="m-c">质量/g</text>
          </div>
          <div class="m-row {{r.isRef ? 'ref' : ''}}" for="(ri, r) in massRows">
            <text class="m-c strong">{{r.coef > 1 ? r.coef : ''}}{{r.display}}{{r.isRef ? ' ●' : ''}}</text>
            <text class="m-c dim">{{r.coef}}×{{r.molMass}}</text>
            <text class="m-c">{{r.moles}}</text>
            <text class="m-c accent">{{r.grams}}</text>
          </div>
        </div>

        <text class="foot-tip">一键「清空」可重新开始 · 支持无限次反复计算</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import { splitReactants } from '../../common/chemistry/parser.js'
import { analyzeList, calcStoich } from '../../common/chemistry/reactions.js'

export default {
  data: function () {
    return {
      inputText: '',
      result: null,
      eqLeftStr: '',
      eqRightStr: '',
      errorMsg: '',
      selIdx: 0,
      massText: '',
      massRows: [],
      massMsg: '',
      touchStartX: 0,
      touchStartY: 0,
      touchStartTime: 0
    }
  },
  goBack() {
    router.back()
  },
  onTouchStart(evt) {
    const t = evt.changedTouches && evt.changedTouches[0]
    if (!t) return
    this.touchStartX = t.clientX != null ? t.clientX : t.pageX
    this.touchStartY = t.clientY != null ? t.clientY : t.pageY
    this.touchStartTime = Date.now()
  },
  onTouchEnd(evt) {
    const t = evt.changedTouches && evt.changedTouches[0]
    if (!t || !this.touchStartTime) return
    const endX = t.clientX != null ? t.clientX : t.pageX
    const endY = t.clientY != null ? t.clientY : t.pageY
    const dx = endX - this.touchStartX
    const dy = endY - this.touchStartY
    const dt = Date.now() - this.touchStartTime
    this.touchStartTime = 0
    if (dx > 90 && Math.abs(dy) < 70 && dt < 800) {
      router.back()
    }
  },
  onInput(evt) {
    this.inputText = evt.value
  },
  onMass(evt) {
    this.massText = evt.value
  },
  fillExample1() {
    this.inputText = '铁+硫酸铜'
    this.doAnalyze()
  },
  fillExample2() {
    this.inputText = '碳酸钙+盐酸'
    this.doAnalyze()
  },
  fillExample3() {
    this.inputText = '过氧化氢'
    this.doAnalyze()
  },
  resetResultView() {
    this.result = null
    this.eqLeftStr = ''
    this.eqRightStr = ''
    this.errorMsg = ''
    this.selIdx = 0
    this.massRows = []
    this.massMsg = ''
  },
  doAnalyze() {
    const tokens = splitReactants(this.inputText)
    if (!tokens.length) {
      this.resetResultView()
      this.errorMsg = '请先输入至少一种反应物'
      return
    }
    const r = analyzeList(tokens)
    if (!r.ok) {
      this.resetResultView()
      this.errorMsg = r.message || '无法推导该反应'
      return
    }
    this.errorMsg = ''
    let left = ''
    let right = ''
    r.substances.forEach((s, i) => {
      const label = (s.coef > 1 ? s.coef : '') + s.display
      const sep = i === 0 ? '' : ' + '
      if (s.side === 'L') left += sep + label
      else right += (right === '' ? '' : ' + ') + label
    })
    this.result = r
    this.eqLeftStr = left
    this.eqRightStr = right
    this.selIdx = 0
    this.massRows = []
    this.massMsg = ''
  },
  pickSub(idx) {
    this.selIdx = idx
    this.massRows = []
    this.massMsg = ''
  },
  doCalcMass() {
    if (!this.result) return
    const out = calcStoich(this.result, this.selIdx, parseFloat(this.massText))
    if (!out.ok) {
      this.massRows = []
      this.massMsg = out.message || '请输入有效的质量'
      return
    }
    this.massMsg = ''
    this.massRows = out.rows.map((row) => {
      const src = this.result.substances[row.index]
      return {
        display: row.display,
        coef: row.coef,
        molMass: src.mass,
        moles: row.moles,
        grams: row.grams,
        isRef: row.isRef
      }
    })
  },
  clearAll() {
    this.inputText = ''
    this.massText = ''
    this.resetResultView()
  }
}
</script>

<style>
