}
.mass-msg {
  color: #f87171;
  font-size: 22px;
  margin-top: 12px;
}
.m-row {
  flex-direction: row;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #202833;
}
.m-row.head {
  border-bottom-color: #2c3742;
  margin-top: 14px;
}
