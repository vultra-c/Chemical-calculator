<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<!--
  化学工具箱 · 合成查询页（336×480，闪念小抄风格）
  逆推查询：输入产物（水 / H2O），列出所有能合成它的反应；
  再空格加一种已知反应物（水 氢气），即可求出还缺的反应物。
  输入卡与「逆推」按钮位于键盘遮挡区之上；结果区全部 absolute 顶层挂载。
-->
<template>
  <div class="page" @swipe="onSwipe">

    <!-- 输入卡（小抄深色大圆角卡片） -->
    <div class="input-card" @click="toggleKb">
      <text if="{{inputStr.length == 0}}" class="input-ph">输入产物，空格分隔：水 / 水 氢气</text>
      <div if="{{inputStr.length > 0}}" class="value-row">
        <text class="input-value">{{inputStr}}</text>
        <text if="{{showKb}}" class="input-caret">_</text>
      </div>
    </div>

    <!-- 操作行（均在键盘遮挡区之上） -->
    <div class="btn-ghost btn-clear" @click="clearAll">
      <text class="btn-ghost-t">清空</text>
    </div>
    <div class="btn-main btn-search" @click="onSearch">
      <text class="btn-main-t">逆推</text>
    </div>

    <!-- 结果区（小抄风格深色面板 + 结果卡片；全部 absolute 顶层挂载） -->
    <div show="{{searched}}" class="panel-bg"></div>
    <text show="{{searched}}" class="panel-hd-t">合成路径</text>
    <text show="{{searched}}" class="panel-hd-n">{{synthResults.length}} 条</text>
    <text show="{{searched && synthResults.length == 0}}" class="panel-none">{{noneMsg}}</text>
    <list show="{{searched && synthResults.length > 0}}" class="eq-list" onscrollbottom="onReachBottom">
      <list-item for="{{visibleResults}}" tid="rid" type="eq" class="{{'eq-item ' + ($item.tall ? 'eq-item-lg' : '')}}" @click="openEquation($item)">
        <div class="eq-content">
          <text class="{{'eq-item-text' + ($item.tall ? ' eq-text-lg' : '')}}">{{$item.text}}</text>
          <text class="{{'eq-item-type' + ($item.tall ? ' eq-type-lg' : '')}}">{{$item.type}}</text>
        </div>
      </list-item>
      <list-item if="{{hasMoreRes}}" type="more" class="eq-more" @click="onReachBottom">
        <div class="eq-more-content">
          <text class="more-text">▼ 还有 {{synthResults.length - visibleResults.length}} 条，上滑加载</text>
        </div>
      </list-item>
    </list>
    <text if="{{!searched}}" class="panel-idle">如：水（查全部合成）或 水 氢气（求缺的反应物）</text>

    <!-- 顶栏（闪念小抄同款） -->
    <img static src="/common/images/hd.png" class="hd-bg" />
    <img static src="/common/images/back.png" class="hd-back" @click="goBack" />
    <text static class="hd-sub">按产物逆推</text>
    <text static class="hd-title">合成查询</text>

    <!-- 共享输入法 -->
    <input-method hide="{{!showKb}}" keyboardtype="QWERTY" screentype="rect" maxlength="12"
      vibratemode="{{vibrateMode}}" @complete="onInput" @delete="onDel"></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { resolveToken } from '../../common/logic/parser.js'
import { NAME_MAP } from '../../common/logic/substances.js'
import { findProducers, findCompletions } from '../../common/logic/reverseQuery.js'
import { buildReactionFromBank, equationText } from '../../common/logic/elementQuery.js'
import { formulaToText } from '../../common/logic/fmt.js'
import { loadSettings } from '../../common/logic/settings.js'

// 分块渲染：首屏 15 条，滚动到底追加 15 条
const RES_CHUNK = 15

export default {
  private: {
    inputStr: '',
    showKb: false,
    searched: false,
    noneMsg: '',
    synthResults: [],
    visibleResults: [],
    renderPos: 0,
    hasMoreRes: false,
    vibrateMode: 'short'
  },

  onInit() {
    loadSettings((s) => {
      this.vibrateMode = s.vibrate === false ? '' : 'short'
    })
  },

  toggleKb() {
    this.showKb = !this.showKb
  },

  onInput(e) {
    if (!e || !e.detail) return
    const ch = String(e.detail.content || '')
    if (!ch || this.inputStr.length >= 40) return

    // 中文名称：直接追加（水、氢气、碳酸钙 …）
    if (/[\u4e00-\u9fa5]/.test(ch)) {
      this.inputStr += ch
      return
    }
    // 分隔符：空格 / 加号 / 逗号（含全角）→ 折叠为单个空格
    if (/^[ +，,＋]$/.test(ch)) {
      if (this.inputStr && this.inputStr.slice(-1) !== ' ') this.inputStr += ' '
      return
    }
    // 字母：token 段首（空格、(、[ 后）或数字后自动补大写
    if (/^[A-Za-z]$/.test(ch)) {
      const seg = this.inputStr.split(/[ +()[\]\u4e00-\u9fa5]/).pop() || ''
      const needUpper = seg === '' || /[0-9]$/.test(seg)
      const lower = ch.toLowerCase()
      const upper = ch.toUpperCase()
      this.inputStr += (needUpper && ch === lower) ? upper : ch
      return
    }
    // 数字、括号
    if (/^[0-9()[\]]$/.test(ch)) {
      this.inputStr += ch
    }
  },

  onDel() {
    if (this.inputStr.length > 0) {
      this.inputStr = this.inputStr.slice(0, -1)
    }
  },

  clearAll() {
    this.inputStr = ''
    this.showKb = false
    this.searched = false
    this.synthResults = []
    this.visibleResults = []
    this.renderPos = 0
    this.hasMoreRes = false
  },

  onReachBottom() {
    if (!this.hasMoreRes || !this.synthResults.length) return
    const end = Math.min(this.renderPos + RES_CHUNK, this.synthResults.length)
    this.visibleResults = this.visibleResults.concat(this.synthResults.slice(this.renderPos, end))
    this.renderPos = end
    this.hasMoreRes = this.renderPos < this.synthResults.length
  },

  onSearch() {
    this.showKb = false
    const tokens = this.inputStr.trim().split(/\s+/).filter(t => t.length > 0)
    if (!tokens.length) { prompt.showToast({ message: '请先输入产物', duration: 1500 }); return }
    if (tokens.length > 2) { prompt.showToast({ message: '最多输入：产物 + 1 种反应物', duration: 1800 }); return }

    // 第一个 token = 产物；第二个 = 已知反应物（可选）
    const product = resolveToken(tokens[0], NAME_MAP)
    if (!product.ok) { prompt.showToast({ message: product.error, duration: 2200 }); return }
    let known = null
    if (tokens.length === 2) {
      known = resolveToken(tokens[1], NAME_MAP)
      if (!known.ok) { prompt.showToast({ message: known.error, duration: 2200 }); return }
    }

    let hits = []
    try {
      if (known) {
        const comps = findCompletions(product.formula, [known.formula], 50)
        // 行文案：方程式 + 类型 · 还需 X（反应物已凑齐则标注）；超 26 字符切两行高卡
        hits = comps.map((c, i) => {
          const eq = equationText(c.entry)
          const missText = c.missing.map(m => formulaToText(m)).join('、')
          return {
            text: eq,
            type: c.missing.length ? c.entry.t + ' · 还需 ' + missText : c.entry.t + ' · 反应物已齐',
            entry: c.entry,
            tall: eq.length > 26,
            rid: 'c' + i
          }
        })
        this.noneMsg = '没有同时使用该反应物的合成路径'
      } else {
        const rows = findProducers(product.formula, 50)
        hits = rows.map((e, i) => {
          const eq = equationText(e)
          return {
            text: eq,
            type: e.t,
            entry: e,
            tall: eq.length > 26,
            rid: 'p' + i
          }
        })
        this.noneMsg = '没有能合成该物质的反应'
      }
    } catch (err) {
      hits = []
    }

    this.synthResults = hits
    this.visibleResults = hits.slice(0, RES_CHUNK)
    this.renderPos = Math.min(RES_CHUNK, hits.length)
    this.hasMoreRes = hits.length > RES_CHUNK
    this.searched = true
    if (hits.length === 0) prompt.showToast({ message: '未找到合成路径', duration: 1800 })
  },

  openEquation(item) {
    try {
      this.$app.$def.reaction = buildReactionFromBank(item.entry)
    } catch (err) {
      prompt.showToast({ message: '打开失败', duration: 1500 })
      return
    }
    router.push({ uri: 'pages/result' })
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') {
      if (this.showKb) this.showKb = false
      else router.back()
    }
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

/* ---- 输入卡（键盘遮挡区之上） ---- */
.input-card {
  position: absolute;
  left: 6px;
  top: 104px;
  width: 324px;
  height: 76px;
  border-radius: 36px;
  background-color: #262626;
  padding: 10px 20px;
  justify-content: center;
}
.input-ph {
  font-size: 22px;
  line-height: 28px;
  color: rgba(255, 255, 255, 0.38);
}
.value-row {
  width: 284px;
  flex-direction: row;
}
.input-value {
  width: 266px;
  font-size: 26px;
  line-height: 32px;
  color: #ffffff;
  lines: 2;
  text-overflow: ellipsis;
}
.input-caret {
  font-size: 26px;
  color: #0d84ff;
}

/* ---- 操作行（bottom <= 252） ---- */
.btn-clear {
  position: absolute;
  left: 6px;
  top: 188px;
  width: 86px;
  height: 56px;
  border-radius: 28px;
}
.btn-search {
  position: absolute;
  left: 100px;
  top: 188px;
  width: 230px;
  height: 56px;
  border-radius: 28px;
}
.btn-clear .btn-ghost-t {
  font-size: 24px;
}
.btn-search .btn-main-t {
  font-size: 26px;
}

/* ---- 结果区（小抄深色面板 + 结果卡片；absolute 顶层挂载） ---- */
.panel-bg {
  position: absolute;
  left: 6px;
  top: 258px;
  width: 324px;
  height: 216px;
  border-radius: 36px;
  background-color: #262626;
}
.panel-hd-t {
  position: absolute;
  left: 26px;
  top: 266px;
  width: 180px;
  font-size: 24px;
  line-height: 30px;
  font-weight: bold;
  color: #ffffff;
}
.panel-hd-n {
  position: absolute;
  left: 214px;
  top: 268px;
  width: 96px;
  font-size: 20px;
  line-height: 26px;
  text-align: right;
  color: #4da3ff;
}
.panel-none {
  position: absolute;
  left: 26px;
  top: 340px;
  width: 284px;
  text-align: center;
  font-size: 20px;
  color: rgba(255, 255, 255, 0.4);
}
.eq-list {
  position: absolute;
  left: 6px;
  top: 302px;
  width: 324px;
  height: 166px;
  padding: 0px 12px;
}
.eq-item {
  width: 100%;
  height: 62px;
  padding: 6px 16px;
  margin-bottom: 7px;
  border-radius: 24px;
  background-color: #333333;
}
.eq-content {
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
}
.eq-item-text {
  width: 100%;
  font-size: 21px;
  line-height: 26px;
  font-weight: bold;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.eq-item-type {
  font-size: 16px;
  line-height: 20px;
  color: #4da3ff;
  margin-top: 1px;
  lines: 1;
  text-overflow: ellipsis;
}
/* 长方程行：76px 两行小字卡（动态 class，与基础行 type 一致） */
.eq-item-lg {
  height: 76px;
}
.eq-text-lg {
  font-size: 18px;
  line-height: 23px;
  lines: 2;
}
.eq-type-lg {
  font-size: 15px;
  line-height: 17px;
}
.eq-more {
  width: 100%;
  height: 44px;
  margin-bottom: 7px;
}
.eq-more-content {
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
}
.more-text {
  font-size: 17px;
  color: rgba(255, 255, 255, 0.35);
}
.panel-idle {
  position: absolute;
  left: 0px;
  top: 340px;
  width: 336px;
  text-align: center;
  font-size: 20px;
  color: rgba(255, 255, 255, 0.3);
}
</style>
