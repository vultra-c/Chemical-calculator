<!--
  化学工具箱 · 反应结果页（336×480，闪念小抄风格）

  性能要点：整条方程式（含系数与 Unicode 下标）在 JS 里拼成「一个字符串」，
  模板里只有一个 text 节点自动折行 —— 相比逐段多节点渲染大幅减少 VDOM 规模。
  主体全部 absolute 顶层挂载；mr-list 列表行静态 class + 显式行高 + div 包裹。

  版面自适应：方程式卡片高度按折行估算分 6 档（l1/l1c/l2/l2c/l3/l3c），
  短方程式收回卡片空间全部让给下方相对分子质量列表（原来固定 196，
  列表只剩 74 高度）。
-->
<template>
  <div class="page" @swipe="onSwipe">

    <!-- 无数据兜底 -->
    <text if="{{!valid}}" class="none-tip">未找到反应数据</text>

    <!-- 方程式卡片（小抄深色大圆角卡片，高度随折行数分档） -->
    <div if="{{valid}}" class="eq-card {{cardVariant}}">
      <text class="eq-text {{textVariant}}">{{eqText}}</text>
      <text if="{{condText}}" class="eq-cond">{{condText}}</text>
      <div class="eq-badge">
        <text class="eq-badge-t">{{rxnType}}</text>
      </div>
    </div>

    <text if="{{valid}}" class="sec-label {{secVariant}}">相对分子质量 · 点按进入质量计算</text>
    <list if="{{valid}}" class="mr-list {{listVariant}}">
      <list-item for="{{mrRows}}" tid="rid" type="mr" class="mr-row" @click="onPickMass($item)">
        <div class="mr-content">
          <text class="mr-f">{{$item.text}}</text>
          <text class="mr-v">M = {{$item.mrText}}</text>
        </div>
      </list-item>
    </list>

    <!-- 底部操作 -->
    <div if="{{valid}}" class="btn-ghost foot-back" @click="goBack">
      <text class="btn-ghost-t">返回修改</text>
    </div>
    <div if="{{valid}}" class="btn-main foot-mass" @click="goMass">
      <text class="btn-main-t">质量计算</text>
    </div>

    <!-- 顶栏（闪念小抄同款） -->
    <img static src="/common/images/hd.png" class="hd-bg" />
    <img static src="/common/images/back.png" class="hd-back" @click="goBack" />
    <text static class="hd-sub">配平结果</text>
    <text static class="hd-title">反应方程式</text>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { loadSettings, fmtOut } from '../../common/logic/settings.js'
import { segsToText } from '../../common/logic/fmt.js'

export default {
  protected: {
    valid: false,
    eqText: '',
    condText: '',
    rxnType: '',
    mrRows: [],
    // 版面档位（l1/l1c/l2/l2c/l3/l3c）：行数 × 有无条件行
    cardVariant: '',
    textVariant: '',
    secVariant: '',
    listVariant: ''
  },

  onInit() {
    const r = this.$app.$def.reaction
    if (!r) { this.valid = false; return }
    this.valid = true
    this._rxn = r

    // 整条方程式单字符串：aX + bY = cZ
    const nR = r.reactants.length
    const parts = []
    for (let i = 0; i < r.coefs.length; i++) {
      if (i === nR) parts.push('=')
      else if (i > 0) parts.push('+')
      parts.push(segsToText(r.segs[i], r.coefs[i]))
    }
    let text = ''
    for (let i = 0; i < parts.length; i++) {
      text += (i > 0 ? ' ' : '') + parts[i]
    }
    this.eqText = text
    this.condText = r.cond ? '条件：' + r.cond : ''
    this.rxnType = r.type

    this.buildRows()
    // 精度设置异步就绪后按最新精度重排数值（幂等）
    loadSettings(() => { this.buildRows() })

    this.applyLayout(text, !!this.condText)
  },

  buildRows() {
    const r = this._rxn
    const rows = []
    for (let i = 0; i < r.coefs.length; i++) {
      rows.push({ text: segsToText(r.segs[i], r.coefs[i]), mrText: fmtOut(r.mr[i]), idx: i, rid: 'm' + i })
    }
    this.mrRows = rows
  },

  /**
   * 版面自适应：估算折行数（1-3）× 有无条件行得到高度档位，
   * 卡片收紧、省下的空间全部让给下方列表。
   * 真机字宽与估算有偏差，故 Unicode 下标加权 0.9、行容量留 5% 冗余，
   * 且长方程（l3 档）自动缩字号到 24px 再兜一层——宁可多算一行也不截断。
   */
  applyLayout(text, hasCond) {
    let units = 0
    for (let i = 0; i < text.length; i++) {
      const ch = text[i]
      const code = ch.charCodeAt(0)
      if (ch === ' ') units += 0.32
      else if (ch === '(' || ch === ')') units += 0.35
      else if (ch === '+') units += 0.55
      else if (ch === '=') units += 0.6
      else if (code >= 65 && code <= 90) units += 0.68       // A-Z
      else if (code >= 97 && code <= 122) units += 0.55     // a-z
      else if (code >= 48 && code <= 57) units += 0.55      // 0-9
      else if (code >= 0x2000) units += 0.9                 // Unicode 下标真机偏宽
      else units += 0.55
    }
    const lines = Math.max(1, Math.min(3, Math.ceil(units / 9.5)))
    const lv = 'l' + lines + (hasCond ? 'c' : '')
    this.cardVariant = 'eq-card-' + lv
    this.textVariant = 'eq-text-' + lv
    this.secVariant = 'sec-' + lv
    this.listVariant = 'mr-list-' + lv
  },

  onPickMass(item) {
    try {
      this.$app.$def.massKnownIdx = item.idx
    } catch (err) {}
    router.push({ uri: 'pages/mass' })
  },

  goMass() { router.push({ uri: 'pages/mass' }) },
  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

.none-tip {
  position: absolute;
  left: 0px;
  top: 220px;
  width: 336px;
  text-align: center;
  font-size: 24px;
  color: rgba(255, 255, 255, 0.35);
}

/* ---- 方程式卡片（小抄深色大圆角卡片，高度随折行数分档） ---- */
.eq-card {
  position: absolute;
  left: 6px;
  top: 108px;
  width: 324px;
  border-radius: 36px;
  background-color: #262626;
  padding: 14px 20px;
  flex-direction: column;
  align-items: center;
}
.eq-text {
  width: 284px;
  font-size: 28px;
  line-height: 40px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  text-overflow: ellipsis;
}
.eq-cond {
  font-size: 20px;
  line-height: 26px;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 4px;
  text-align: center;
}
.eq-badge {
  padding: 4px 18px;
  border-radius: 15px;
  background-color: rgba(13, 110, 255, 0.22);
  margin-top: 6px;
}
.eq-badge-t {
  font-size: 19px;
  color: #4da3ff;
}

/* 卡片六档高度：内边距 28 + 行数 * 40 + 条件行 30 + 徽标块约 34 */
.eq-card-l1  { height: 102px; }
.eq-card-l1c { height: 132px; }
.eq-card-l2  { height: 142px; }
.eq-card-l2c { height: 172px; }
.eq-card-l3  { height: 182px; }
.eq-card-l3c { height: 212px; }
/* 长方程降档缩字号：l2 26px / l3 24px，防真机字宽偏差导致截断 */
.eq-text-l1,  .eq-text-l1c { lines: 1; }
.eq-text-l2,  .eq-text-l2c { lines: 2; font-size: 26px; line-height: 38px; }
.eq-text-l3,  .eq-text-l3c { lines: 3; font-size: 24px; line-height: 34px; }

.sec-label {
  position: absolute;
  left: 16px;
  width: 304px;
  font-size: 20px;
  line-height: 24px;
  color: rgba(255, 255, 255, 0.45);
}
/* 标签顶 = 卡片底(108+卡高) + 6 */
.sec-l1  { top: 216px; }
.sec-l1c { top: 246px; }
.sec-l2  { top: 256px; }
.sec-l2c { top: 286px; }
.sec-l3  { top: 296px; }
.sec-l3c { top: 326px; }

.mr-list {
  position: absolute;
  left: 6px;
  width: 324px;
}
/* 列表：顶部贴标签(标签顶+28)，底边止于 412（按钮 418 上留 6） */
.mr-list-l1  { top: 244px; height: 168px; }
.mr-list-l1c { top: 274px; height: 138px; }
.mr-list-l2  { top: 284px; height: 128px; }
.mr-list-l2c { top: 314px; height: 98px; }
.mr-list-l3  { top: 324px; height: 88px; }
.mr-list-l3c { top: 354px; height: 58px; }
/* list-item：静态 class + 显式行高/间距，内容内层 div 包裹 */
.mr-row {
  width: 100%;
  height: 62px;
  border-radius: 24px;
  background-color: #262626;
  padding: 0 18px;
  margin-bottom: 8px;
}
.mr-content {
  width: 100%;
  height: 100%;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.mr-f {
  font-size: 24px;
  font-weight: bold;
  color: #ffffff;
}
.mr-v {
  font-size: 22px;
  color: rgba(255, 255, 255, 0.72);
}

/* ---- 底部操作（56 高，bottom <= 472） ---- */
.foot-back {
  position: absolute;
  left: 6px;
  top: 418px;
  width: 158px;
  height: 56px;
  border-radius: 28px;
}
.foot-mass {
  position: absolute;
  left: 172px;
  top: 418px;
  width: 158px;
  height: 56px;
  border-radius: 28px;
}
.foot-back .btn-ghost-t {
  font-size: 24px;
}
.foot-mass .btn-main-t {
  font-size: 24px;
}
</style>
