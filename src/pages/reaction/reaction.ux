<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<!--
  化学工具箱 · 反应计算页（336×480，闪念小抄风格）
  可用性原则保留：输入卡与「计算反应」按钮全部位于键盘遮挡区之上（<=252px），
  键盘弹出时所有可点元素依然可用。
  输入支持：化学式（Fe+O2）与中文名（铁+氧气），用 + 分隔。
-->
<template>
  <div class="page" @swipe="onSwipe">

    <!-- 输入卡（小抄深色大圆角卡片）：点击弹出/收起键盘 -->
    <div class="{{showKb ? 'input-card input-card-on' : 'input-card'}}" @click="toggleKb">
      <text if="{{inputStr.length == 0}}" class="input-ph">输入反应物，用 + 连接，如 Fe+O2 或 铁+氧气</text>
      <div if="{{inputStr.length > 0}}" class="value-row">
        <text class="input-value">{{inputStr}}</text>
        <text if="{{showKb}}" class="input-caret">_</text>
      </div>
    </div>

    <!-- 操作行：清空 + 计算反应（均在键盘遮挡区之上） -->
    <div class="btn-ghost btn-clear" @click="clearAll">
      <text class="btn-ghost-t">清空</text>
    </div>
    <div class="btn-main btn-calc" @click="onCalc">
      <text class="btn-main-t">计算反应</text>
    </div>

    <!-- 示例：点选直接算（键盘弹出时也可点，位于遮挡区上方） -->
    <scroll class="ex-scroll" scroll-x="{{true}}">
      <div class="ex-row">
        <div class="ex-chip" for="{{examples}}" tid="id" @click="useExample($item)">
          <text class="ex-t">{{$item.label}}</text>
        </div>
      </div>
    </scroll>

    <!-- 提示 -->
    <text class="hint-tip">空格键 = 加号 · 支持中文物质名与大小写混输</text>

    <!-- 顶栏（闪念小抄同款） -->
    <img static src="/common/images/hd.png" class="hd-bg" />
    <img static src="/common/images/back.png" class="hd-back" @click="goBack" />
    <text static class="hd-sub">输入反应物</text>
    <text static class="hd-title">反应计算</text>

    <!-- 共享输入法 -->
    <input-method hide="{{!showKb}}" keyboardtype="QWERTY" screentype="rect" maxlength="8"
      vibratemode="{{vibrateMode}}" @complete="onInput" @delete="onDel"></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { splitInputTokens, resolveToken } from '../../common/logic/parser.js'
import { solveReaction } from '../../common/logic/reactions.js'
import { NAME_MAP } from '../../common/logic/substances.js'
import { loadSettings } from '../../common/logic/settings.js'

export default {
  private: {
    inputStr: '',
    showKb: false,
    vibrateMode: 'short',
    examples: [
      { id: 'x1', label: '铁+氧气', text: '铁+氧气' },
      { id: 'x2', label: 'H2+O2', text: 'H2+O2' },
      { id: 'x3', label: '锌+稀硫酸', text: '锌+稀硫酸' },
      { id: 'x4', label: '碳酸钙', text: '碳酸钙' },
      { id: 'x5', label: '过氧化氢', text: '过氧化氢' },
      { id: 'x6', label: 'Mg+CO2', text: 'Mg+CO2' },
      { id: 'x7', label: 'KMnO4+HCl', text: 'KMnO4+HCl' }
    ]
  },

  onInit() {
    loadSettings((s) => {
      this.vibrateMode = s.vibrate === false ? '' : 'short'
    })
  },

  onShow() {
    // 从「常用物质表」带回的物质公式，自动拼到输入末尾
    const pf = this.$app.$def.pendingFormula
    if (pf) {
      this.$app.$def.pendingFormula = ''
      if (this.inputStr && this.inputStr.slice(-1) !== '+') {
        this.inputStr += '+'
      }
      if (this.inputStr.length + pf.length <= 60) {
        this.inputStr += pf
      }
      prompt.showToast({ message: '已加入 ' + pf, duration: 900 })
    }
  },

  toggleKb() {
    this.showKb = !this.showKb
  },

  onInput(e) {
    if (!e || !e.detail) return
    const ch = String(e.detail.content || '')
    if (!ch || this.inputStr.length >= 60) return

    // 中文名称：直接追加（如 铁、氧气、碳酸钙）
    if (/[\u4e00-\u9fa5]/.test(ch)) {
      this.inputStr += ch
      return
    }
    // 分隔：空格 / 加号 / 全角加号 → +
    if (ch === ' ' || ch === '+' || ch === '＋') {
      if (this.inputStr && this.inputStr.slice(-1) !== '+') this.inputStr += '+'
      return
    }
    // 字母：段首（+、(、[ 后或数字后）自动补大写；用户主动切大写锁定时原样输出
    // 整词候选提交（如键盘联想上屏的 "ca"）逐字符按同一规则处理，不能整串丢弃
    if (/^[A-Za-z]+$/.test(ch)) {
      for (let ci = 0; ci < ch.length; ci++) {
        const c1 = ch[ci]
        const seg = this.inputStr.split(/[+()[\]\u4e00-\u9fa5]/).pop() || ''
        const needUpper = seg === '' || /[0-9]$/.test(seg)
        const lower = c1.toLowerCase()
        const upper = c1.toUpperCase()
        this.inputStr += (needUpper && c1 === lower) ? upper : c1
      }
      return
    }
    // 数字、括号、小数点
    if (/^[0-9()[\].]$/.test(ch)) {
      this.inputStr += ch
    }
  },

  onDel() {
    if (this.inputStr.length > 0) {
      this.inputStr = this.inputStr.slice(0, -1)
    }
  },

  clearAll() {
    this.inputStr = ''
    this.showKb = false
    prompt.showToast({ message: '已清空', duration: 700 })
  },

  useExample(item) {
    if (!item || !item.text) return
    this.inputStr = item.text
    this.showKb = false
    this.onCalc()
  },

  onCalc() {
    this.showKb = false
    const raw = this.inputStr.trim()
    if (!raw) { prompt.showToast({ message: '请先输入反应物', duration: 1500 }); return }

    let result = null
    try {
      const tokens = splitInputTokens(raw)
      if (!tokens.length) { prompt.showToast({ message: '无有效反应物', duration: 1500 }); return }

      const formulas = []
      for (let i = 0; i < tokens.length; i++) {
        const resolved = resolveToken(tokens[i], NAME_MAP)
        if (!resolved.ok) { prompt.showToast({ message: resolved.error, duration: 2200 }); return }
        formulas.push(resolved.formula)
      }
      result = solveReaction(formulas)
    } catch (err) {
      prompt.showToast({ message: '计算出错，请检查输入', duration: 2000 })
      return
    }
    if (!result || !result.ok) {
      prompt.showToast({ message: (result && result.error) || '暂无法推导该反应', duration: 2600 })
      return
    }

    try {
      this.$app.$def.reaction = result.reaction
    } catch (err) {
      prompt.showToast({ message: '数据写入失败', duration: 2000 })
      return
    }
    router.push({ uri: 'pages/result' })
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') {
      if (this.showKb) this.showKb = false
      else router.back()
    }
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

/* ---- 输入卡（top 104 起，键盘遮挡区之上） ---- */
.input-card {
  position: absolute;
  left: 6px;
  top: 104px;
  width: 324px;
  height: 76px;
  border-radius: 36px;
  background-color: #262626;
  padding: 10px 20px;
  justify-content: center;
}
.input-card-on {
  border: 2px solid #0d6eff;
  padding: 8px 18px;
}
.input-ph {
  font-size: 22px;
  line-height: 28px;
  color: rgba(255, 255, 255, 0.38);
}
.value-row {
  width: 284px;
  flex-direction: row;
}
.input-value {
  width: 266px;
  font-size: 26px;
  line-height: 32px;
  color: #ffffff;
  lines: 2;
  text-overflow: ellipsis;
}
.input-caret {
  font-size: 26px;
  color: #0d84ff;
}

/* ---- 操作行（bottom <= 252，键盘遮挡区之上；覆盖公共宽高） ---- */
.btn-clear {
  position: absolute;
  left: 6px;
  top: 188px;
  width: 86px;
  height: 56px;
  border-radius: 28px;
}
.btn-calc {
  position: absolute;
  left: 100px;
  top: 188px;
  width: 230px;
  height: 56px;
  border-radius: 28px;
}
.btn-clear .btn-ghost-t {
  font-size: 24px;
}
.btn-calc .btn-main-t {
  font-size: 26px;
}

.hint-tip {
  position: absolute;
  left: 16px;
  top: 316px;
  width: 304px;
  font-size: 18px;
  line-height: 24px;
  color: rgba(255, 255, 255, 0.3);
}

/* ---- 示例 chips（键盘弹出时也可点：bottom 216） ---- */
.ex-scroll {
  position: absolute;
  left: 6px;
  top: 264px;
  width: 324px;
  height: 44px;
}
.ex-row {
  flex-direction: row;
}
.ex-chip {
  height: 42px;
  border-radius: 21px;
  background-color: #262626;
  padding: 0 18px;
  margin-right: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.ex-t {
  font-size: 20px;
  color: rgba(255, 255, 255, 0.72);
}</style>
