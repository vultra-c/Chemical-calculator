  margin-bottom: 18px;
}
.card {
  background-color: #151b23;
  border-radius: 20px;
  padding: 20px 24px;
  margin-bottom: 14px;
  flex-direction: row;
  align-items: center;
  width: 100%;
}
.z {
  color: #55606c;
  font-size: 20px;
  width: 44px;
}
.sym {
  color: #34d399;
  font-size: 34px;
  font-weight: bold;
  width: 96px;
}
.mid {
  flex-direction: column;
  flex-grow: 1;
}
.name {
  color: #f2f6f8;
