  color: #34d399;
  font-size: 25px;
}
.kb-wrap {
  flex-direction: column;
  background-color: #10161d;
  border-radius: 22px;
  padding: 14px 12px;
  margin-bottom: 16px;
  width: 100%;
}
.kb-row {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 8px;
}
.key {
  background-color: #1c2530;
  color: #e8eef3;
  font-size: 22px;
  border-radius: 12px;
  padding: 12px 0;
  width: 64px;
  margin: 0 5px;
  text-align: center;
}
.key.num {
  background-color: #232f3c;
  color: #7fd7b6;
}
.key.clear {
  background-color: #2a3644;
  color: #fbbf24;
}
.key.del {
  background-color: rgba(248, 113, 113, 0.16);
  color: #f87171;
}
