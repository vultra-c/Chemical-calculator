  flex-direction: row;
  align-items: center;
  background-color: #151b23;
  border-radius: 16px;
  padding: 16px 20px;
  margin-bottom: 14px;
  width: 100%;
}
.ipt-text {
  color: #f2f6f8;
  font-size: 25px;
  flex-grow: 1;
}
