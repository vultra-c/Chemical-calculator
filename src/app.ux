<script>
// Vela 全局数据容器：app.ux 导出对象上的属性会成为 $app.$def.*，
// 页面通过 this.$app.$def.reaction 等跨页读写（不要在 app 里用 this.$data）。
import { loadSettings, applyKeepScreenOn } from './common/logic/settings.js'

export default {
  // 反应计算 → 结果页：配平完成的反应数据
  reaction: null,
  // 常用物质表 → 反应计算页：选中的化学式
  pendingFormula: '',
  // 结果页 → 质量计算页：已知质量的物质下标
  massKnownIdx: 0,

  // 常亮显示的「记忆」：setKeepScreenOn 退出应用即由系统复位，
  // 因此每次启动都按持久化设置重新打开一次。
  onCreate() {
    loadSettings((s) => {
      if (s.keepScreenOn) applyKeepScreenOn(true)
    })
  }
}
</script>
